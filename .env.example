# Copy to .env (never commit it), fill in, then: docker compose up --build

# 64 hex chars. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Space-separated name:role:hash entries. role is admin (approve, delete) or rep.
# Hash a password: cd backend && .venv/bin/python main.py hash-password
AUTH_USERS=

# 1 = load the demo library and 30 days of sample analytics into an empty database.
SEED_DEMO=1

# Session cookie is Secure by default (browsers allow it on http://localhost).
# Set 0 only for plain-http testing on a LAN IP; use HTTPS in production.
COOKIE_SECURE=1
